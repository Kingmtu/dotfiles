# Zathura configuration file
# See man `man zathurarc'

# Open document in fit-width mode by default
set adjust-open "best-fit"

# One page per row by default
set pages-per-row 1

#stop at page boundries
set scroll-page-aware "true"
set smooth-scroll "true"
set scroll-full-overlap 0.01
set scroll-step 100

#zoom settings
set zoom-min 10
set guioptions ""

# Theme using template variables
set recolor "true"

set completion-bg "#000003"
set completion-fg "#F1F3F7"
set completion-group-bg "#000003"
set completion-group-fg "#678F98"
set completion-highlight-bg "#F1F3F7"
set completion-highlight-fg "#000003"

set recolor-lightcolor "#000003"
set recolor-darkcolor "#F1F3F7"
set default-bg "#000003"
set default-fg "#F1F3F7"

set inputbar-bg "#000003"
set inputbar-fg "#F1F3F7"
set notification-bg "#000003"
set notification-fg "#F1F3F7"
set notification-error-bg "#8D7288"
set notification-error-fg "#F1F3F7"
set notification-warning-bg "#8D7288"
set notification-warning-fg "#F1F3F7"
set statusbar-bg "#000003"
set statusbar-fg "#F1F3F7"
set index-bg "#000003"
set index-fg "#F1F3F7"
set index-active-bg "#F1F3F7"
set index-active-fg "#000003"
set render-loading-bg "#000003"
set render-loading-fg "#F1F3F7"

set window-title-home-tilde true
set statusbar-basename true
set selection-clipboard clipboard

set font "JetbrainsMono Nerd Font 10"
set recolor-reverse-video "true"
set recolor-keephue "true"
set render-loading "false"
set scroll-step 50
unmap f
map f toggle_fullscreen
map [fullscreen] f toggle_fullscreen