layout {

    focus-ring {
        active-color   "#abccd4"
        inactive-color "#000000"
        urgent-color   "#ffb4ab"
    }

    border {
        active-color   "#abccd4"
        inactive-color "#000000"
        urgent-color   "#ffb4ab"
    }


    tab-indicator {
        active-color   "#abccd4"
        inactive-color "#54737a"
        urgent-color   "#ffb4ab"
    }

    insert-hint {
        color "#abccd480"
    }
}

recent-windows {
    highlight {
        active-color "#abccd4"
        urgent-color "#ffb4ab"
    }
}
