// === Environment Variables ===
// Sets environment variables for the Niri session (docs: Configuration: Miscellaneous).
// Useful for Wayland hints, themes, etc. Values override system defaults; use null to unset.
environment {
    DISPLAY ":2"  // Custom display for compatibility.
    ELECTRON_OZONE_PLATFORM_HINT "auto"  // Auto-detect for Electron apps.
    XCURSOR_THEME "Bibata-Modern-Ice"  // XCursor theme.
    XCURSOR_SIZE "24"  // Cursor size in pixels.
    HYPRCURSOR_THEME "catppuccin-macchiato-lavender-cursors"  // Hyprcursor theme.
    HYPRCURSOR_SIZE "24"  // Hyprcursor size.
    QT_CURSOR_THEME "catppuccin-macchiato-lavender-cursors"  // Qt cursor theme.
    QT_CURSOR_SIZE "24"  // Qt cursor size.
    XDG_SESSION_TYPE "wayland"  // Declare Wayland session.
    GDK_BACKEND "wayland,x11,*"  // GDK backends (Wayland primary).
    XDG_CURRENT_DESKTOP "wlroots"  // Desktop environment hint.
    QT_QPA_PLATFORM "wayland"  // Qt platform.
    QT_QPA_PLATFORMTHEME "qt5ct"  // Qt theme integration.
    QT_WAYLAND_DISABLE_WINDOWDECORATION "1"  // Disable Qt window decorations.
    QT_STYLE_OVERRIDE "kvantum"  // Qt style.
    QT_WAYLAND_DECORATION "kvantum"  // Qt decoration style.
}
/// Swayidle
spawn-at-startup "swayidle" "-w" \
    "timeout" "1200" "swaylock -f" \
    "timeout" "600" "niri msg action power-off-monitors" \
    "before-sleep" "swaylock -f"


// === Startup Processes ===
// Spawn processes at startup in order (docs: Configuration: Miscellaneous).
// Use for daemons, applets, and integrations. Runs before the compositor is ready.
spawn-at-startup "dbus-update-activation-environment" "--systemd" "WAYLAND_DISPLAY" "XDG_CURRENT_DESKTOP"  // Update env for portals.
spawn-at-startup "/usr/lib/xdg-desktop-portal-gnome"  // XDG portals for desktop integration.
spawn-at-startup "xwayland-satellite"  // XWayland support.
spawn-at-startup "awww-daemon"  // Wallpaper daemon.
spawn-at-startup "ollama serve"  // Wallpaper daemon.
spawn-at-startup "awww restore"  // Restore wallpaper.
spawn-at-startup "waybar"  // Status bar.
spawn-at-startup "dunst"  // Notification daemon.
spawn-at-startup "bluetoothctl" "power" "on"  // Enable Bluetooth.
spawn-at-startup "blueman-applet"  // Bluetooth applet.
spawn-at-startup "nm-applet" "--indicator"  // Network applet.
spawn-at-startup "/usr/lib/polkit-gnome/polkit-gnome-authentication-agent-1"
spawn-at-startup "dbus-update-activation-environment" "--systemd" "WAYLAND_DISPLAY" "XDG_CURRENT_DESKTOP"
// === Screenshot Settings ===
// Path template for screenshots using strftime format (docs: Configuration: Miscellaneous).
screenshot-path "~/Pictures/Screenshots/Screenshot from %Y-%m-%d %H-%M-%S.png"

// === Input Configuration ===
// Configures keyboards, pointers, etc. (docs: Configuration: Input).
// Settings apply globally; no per-device config yet.
input {
    keyboard {
        xkb {
            layout "us"  // Keyboard layout.
            options "grp:alt_shift_toggle"  // Toggle layouts with Alt+Shift.
        }
        repeat-delay 600  // Default repeat delay (ms).
        repeat-rate 25  // Default repeat rate (chars/sec).
    }
    touchpad {
        tap  // Enable tap-to-click.
        natural-scroll  // Enable natural scrolling (added for consistency with mouse).
    }
    mouse {
        natural-scroll  // Enable natural scrolling.
        accel-speed 0.5  // Acceleration speed.
    }
    focus-follows-mouse max-scroll-amount="5%"  // Enable with scroll limit to prevent accidental switches.
    workspace-auto-back-and-forth  // Added: Switch back to previous workspace on repeat (improvement).
}

// === Hotkey Overlay ===
// Shows all bindings when triggered (docs: Configuration: Miscellaneous).
// Skips at startup by default.
hotkey-overlay {
    skip-at-startup  // Do not show overlay on launch.
}

// === Cursor Settings ===
// Overrides cursor theme and size (docs: Configuration: Miscellaneous).
// Sets XCURSOR_THEME and XCURSOR_SIZE env vars.
cursor {
    xcursor-theme "Bibata-Modern-Ice"
    xcursor-size 24
    // hide-after-inactive-ms 2000  // Optional: Hide cursor after inactivity (improvement).
}

// === Client-Side Decorations Preference ===
// Prefer no CSD for apps (docs: Configuration: Miscellaneous).
prefer-no-csd

// === Output Configurations ===
// Per-output settings by connector name (docs: Configuration: Outputs).
// Use `niri msg outputs` for names/modes. Fixed positions to avoid overlap.
output "HDMI-A-1" {
    mode "1366x768@59.790"  // Resolution and refresh rate.
    position x=0 y=0  // Adjusted to start at origin for logical layout.
    scale 1.0  // Scaling factor.
    variable-refresh-rate on-demand=true  // VRR on-demand for efficiency.
}
output "DP-2" {
    mode "1280x1024@75.025"
    position x=1366 y=0  // Placed to the right of HDMI-A-1.
    scale 1.0
    variable-refresh-rate on-demand=true
}

// === Layer Rules ===
// Rules for layer-shell windows like panels (docs: Configuration: Layer-Rules).
// Applied sequentially; matches use regex.
layer-rule {
    match namespace="waybar"
    match at-startup=true
    // opacity 0.5  // Semi-transparent.
    block-out-from "screencast"  // Exclude from screencasts.
    shadow {
        on  // Enable shadow.
        softness 40  // Blur radius.
        spread 5  // Expansion.
        offset x=0 y=5  // Shift.
        draw-behind-window true  // Behind surface.
        color "#00000064"  // Color with alpha.
    }
    geometry-corner-radius 5  // Rounded corners.
    place-within-backdrop true  // In overview backdrop.
    baba-is-float false  // Disable floating animation.
}
layer-rule {
    match namespace="^awww$"
    place-within-backdrop true  // Wallpaper in backdrop.
}
layer-rule {
    match namespace="rofi"
    match at-startup=true
    opacity 0.9  // Semi-transparent.
}
overview {
  backdrop-color "transparent"
  //wallpaper-in-backdrop stationary
}


// === Window Rules ===
// Rules for XWayland/Wayland windows (docs: Configuration: Window-Rules).
// Applied sequentially; use match/exclude.
window-rule {
    match is-active=false
    opacity 0.9  // Dim inactive windows.
}
window-rule {
    geometry-corner-radius 5  // Rounded corners for all.
    clip-to-geometry true  // Clip to geometry.
    block-out-from "screen-capture"  // Exclude from captures.
}
window-rule {
    match app-id="^mpv$"
    variable-refresh-rate true  // VRR for video player.
}

// === Layout Settings ===
// Tiling and visual layout (docs: Configuration: Layout).
// === Layout Settings ===
// Tiling and visual layout (docs: Configuration: Layout).
layout {
    gaps 5  // Gaps around windows.
    background-color "transparent"  // Transparent for wallpapers.
    preset-column-widths {
        proportion 0.5  // Half width.
        proportion 1.0  // Full width.
    }
    preset-window-heights {
        proportion 0.5  // Half height.
        proportion 1.0  // Full height.
    }
    default-column-width {}  // Auto or last preset.
    focus-ring {
        off
        width 4  // Focus ring width around active window.
        active-gradient from="#87CEEB" to="#4682B4" angle=45 relative-to="workspace-view"  // Sky blue gradient for active window.
        inactive-gradient from="#B0C4DE" to="#D3DCE6" angle=45 relative-to="workspace-view"  // Subtle blue-gray for inactive windows.    border {
    }
    struts {
        // Reserved edges (uncomment for panels).
        // left 64
        // right 64
        // top 64
        // bottom 64
    }
    center-focused-column "on-overflow"  // Center when overflowing.
}
// === Animations ===
// Animation configs (docs: Configuration: Animations).
// Slowdown >1 slows; <1 speeds up.
animations {
    slowdown 1.2  // Slightly slower animations.
    workspace-switch {
        spring damping-ratio=1.0 stiffness=1000 epsilon=0.0001
    }
    window-open {
        duration-ms 150
        curve "ease-out-expo"
    }
    window-close {
        duration-ms 150
        curve "ease-out-quad"
    }
}

// === Key Bindings ===
// All binds must be defined; no defaults (docs: Configuration: Binds).
// Organized by category for readability. Mod is Super (or Alt nested).
// Use allow-when-locked for media keys.
binds {
    // --- Overlay and Launchers ---
    Mod+Shift+Slash { show-hotkey-overlay; }  // Show binds overlay.
    Mod+R { spawn "wofi" "-i" "--show drun"; }  // App launcher.
    Mod+y { spawn "~/.config/scripts/yazi.sh"; }  // File manager.
    Mod+T { spawn "thorium-browser"; }  // Browser.
    Mod+Shift+W { spawn "~/.config/scripts/wallpaperSelect.sh"; }  // Wallpaper selector.
    Mod+Return { spawn "kitty"; }  // Terminal.
    Mod+W { spawn "waypaper" " --next"; }  // Next wallpaper.
    Mod+B { spawn "~/.config/scripts/waybar.sh"; }  // Waybar script.
    Mod+Space { spawn "~/.config/rofi/launchers/type-1/launcher.sh"; }  // Rofi launcher.
    Mod+Shift+Return { spawn "foot"; }  // Alternative terminal.
    Mod+Shift+T { spawn "thunar"; }  // Radio app.
    Mod+Shift+P { spawn "librewolf"; }  // Privacy browser.
    Mod+Shift+C { spawn "qalculate-gtk"; }  // Calculator.
    Mod+G { spawn "hyprpicker" "-ra"; }  // Color picker.
    Mod+O { spawn "obsidian"; }  // Note-taking.
    Mod+N { spawn "pavucontrol"; }  // Audio control.
    Mod+Shift+N { spawn "blueman-manager"; }  // Bluetooth manager.
    Mod+Shift+L { spawn "wlogout"; }  // Logout menu.
    Mod+Shift+O { toggle-window-rule-opacity; }  // Toggle opacity rule.
    Mod+L { spawn "swaylock"; }
    // --- Media and Volume Controls ---
    XF86AudioRaiseVolume allow-when-locked=true { spawn "wpctl" "set-volume" "@DEFAULT_AUDIO_SINK@" "0.1+"; }
    XF86AudioLowerVolume allow-when-locked=true { spawn "wpctl" "set-volume" "@DEFAULT_AUDIO_SINK@" "0.1-"; }
    XF86AudioMute allow-when-locked=true { spawn "wpctl" "set-mute" "@DEFAULT_AUDIO_SINK@" "toggle"; }
    XF86AudioMicMute allow-when-locked=true { spawn "wpctl" "set-mute" "@DEFAULT_AUDIO_SOURCE@" "toggle"; }
    XF86AudioNext allow-when-locked=true { spawn "playerctl" "next"; }
    XF86AudioPrev allow-when-locked=true { spawn "playerctl" "previous"; }
    XF86AudioPlay allow-when-locked=true { spawn "playerctl" "play-pause"; }
    XF86AudioPause allow-when-locked=true { spawn "playerctl" "play-pause"; }
    XF86AudioStop allow-when-locked=true { spawn "playerctl" "stop"; }

    // --- Window Management ---
    Mod+Q { close-window; }  // Close focused window.
    Mod+Shift+E { quit; }  // Quit Niri.
    Ctrl+Alt+Delete { quit; }  // Emergency quit.
    Mod+Alt+L { power-off-monitors; }  // Turn off monitors.
    Mod+K { toggle-column-tabbed-display; }  // Toggle tabbed mode.
    Mod+V { toggle-window-floating; }  // Toggle floating.
    Mod+Shift+V { switch-focus-between-floating-and-tiling; }  // Switch focus layers.

    // --- Focus Navigation ---
    Mod+Left { focus-column-left; }
    Mod+Right { focus-column-right; }
    Mod+Down { focus-window-down; }
    Mod+Up { focus-window-up; }
    Mod+Home { focus-column-first; }
    Mod+End { focus-column-last; }
    Mod+Ctrl+Left { focus-monitor-left; }
    Mod+Ctrl+Down { focus-monitor-down; }
    Mod+Ctrl+Up { focus-monitor-up; }
    Mod+Ctrl+Right { focus-monitor-right; }
    Mod+Page_Down { focus-workspace-down; }
    Mod+Page_Up { focus-workspace-up; }
    Mod+I { focus-workspace-down; }
    Mod+U { focus-workspace-up; }
    Mod+Tab { focus-workspace-previous; }

    // --- Move Windows/Columns ---
    Mod+Shift+Left { move-column-left; }
    Mod+Shift+Down { move-window-down; }
    Mod+Shift+Up { move-window-up; }
    Mod+Shift+Right { move-column-right; }
    Mod+Shift+Home { move-column-to-first; }
    Mod+Shift+End { move-column-to-last; }
    Mod+Alt+Left { move-column-to-monitor-left; }
    Mod+Alt+Right { move-column-to-monitor-right; }
    Mod+Shift+Page_Down { move-column-to-workspace-down; }
    Mod+Shift+Page_Up { move-column-to-workspace-up; }
    Mod+Shift+I { move-column-to-workspace-down; }
    Mod+Shift+U { move-column-to-workspace-up; }
    Mod+Ctrl+Page_Down { move-workspace-down; }
    Mod+Ctrl+Page_Up { move-workspace-up; }
    Mod+Ctrl+I { move-workspace-down; }
    Mod+Ctrl+U { move-workspace-up; }

    // --- Mouse Wheel Binds ---
    Mod+WheelScrollDown cooldown-ms=150 { focus-workspace-down; }
    Mod+WheelScrollUp cooldown-ms=150 { focus-workspace-up; }
    Mod+Ctrl+WheelScrollDown { focus-column-right; }
    Mod+Ctrl+WheelScrollUp { focus-column-left; }
    Mod+Alt+WheelScrollDown cooldown-ms=150 { move-column-to-workspace-down; }
    Mod+Alt+WheelScrollUp cooldown-ms=150 { move-column-to-workspace-up; }
    Mod+Ctrl+WheelScrollRight { move-column-right; }
    Mod+Ctrl+WheelScrollLeft { move-column-left; }
    Mod+Shift+WheelScrollDown { focus-column-right; }
    Mod+Shift+WheelScrollUp { focus-column-left; }
    Mod+Ctrl+Shift+WheelScrollDown { move-column-right; }
    Mod+Ctrl+Shift+WheelScrollUp { move-column-left; }

    // --- Workspace Number Binds ---
    Mod+1 { focus-workspace 1; }
    Mod+2 { focus-workspace 2; }
    Mod+3 { focus-workspace 3; }
    Mod+4 { focus-workspace 4; }
    Mod+5 { focus-workspace 5; }
    Mod+6 { focus-workspace 6; }
    Mod+7 { focus-workspace 7; }
    Mod+8 { focus-workspace 8; }
    Mod+9 { focus-workspace 9; }
    Mod+0 { focus-workspace 10; }
    Mod+Shift+1 { move-column-to-workspace 1; }
    Mod+Shift+2 { move-column-to-workspace 2; }
    Mod+Shift+3 { move-column-to-workspace 3; }
    Mod+Shift+4 { move-column-to-workspace 4; }
    Mod+Shift+5 { move-column-to-workspace 5; }
    Mod+Shift+6 { move-column-to-workspace 6; }
    Mod+Shift+7 { move-column-to-workspace 7; }
    Mod+Shift+8 { move-column-to-workspace 8; }
    Mod+Shift+9 { move-column-to-workspace 9; }
    Mod+Shift+0 { move-column-to-workspace 10; }

    // --- Layout Adjustments ---
    Mod+BracketLeft { consume-or-expel-window-left; }
    Mod+BracketRight { consume-or-expel-window-right; }
    Mod+Comma { consume-window-into-column; }
    Mod+Period { expel-window-from-column; }
    Mod+D { switch-preset-column-width; }  // Cycle column widths.
    Mod+F { maximize-column; }  // Maximize column.
    Mod+Shift+D { switch-preset-window-height; }  // Cycle window heights.
    Mod+Ctrl+Shift+D { reset-window-height; }  // Reset height.
    Mod+Shift+F { fullscreen-window; }  // Fullscreen window.
    Mod+C { center-column; }  // Center column.
    Mod+Minus { set-column-width "-10%"; }  // Shrink column.
    Mod+Equal { set-column-width "+10%"; }  // Expand column.
    Mod+Shift+Minus { set-window-height "-10%"; }  // Shrink height.
    Mod+Shift+Equal { set-window-height "+10%"; }  // Expand height.

    // --- Screenshots ---
    Print  { screenshot; }  // Full screenshot.
    Ctrl+P { screenshot; }  // Full screenshot.
    Alt+Print { screenshot-screen; }  // Screen screenshot.
    Shift+Print { screenshot-window; }  // Window screenshot.
}
